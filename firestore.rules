rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validations
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) 
        && data.keys().size() <= 6
        && data.uid == request.auth.uid 
        && data.email is string 
        && data.email.size() <= 256;
    }

    function isValidCartItem(data) {
      return data.keys().hasAll(['productId', 'quantity'])
        && data.keys().size() <= 10
        && data.productId is string
        && data.productId.size() <= 128
        && data.quantity is int 
        && data.quantity > 0;
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email']);
      
      // Cart Sub-collection
      match /cart/{itemId} {
        allow list: if isOwner(userId);
        allow get: if isOwner(userId);
        allow create: if isOwner(userId) && isValidCartItem(incoming());
        allow update: if isOwner(userId) && isValidCartItem(incoming())
          && incoming().diff(existing()).affectedKeys().hasOnly(['quantity', 'size']);
        allow delete: if isOwner(userId);
      }
    }
  }
}
